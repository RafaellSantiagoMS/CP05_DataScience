   "source": [
    "X_tr, X_val, y_tr, y_val = train_test_split(X_treino, y_treino, test_size=0.2, random_state=SEED)\n",
    "pipe_escolhido.fit(X_tr, np.log1p(y_tr))\n",
    "previsto_val = np.exp(pipe_escolhido.predict(X_val)) - 1   # volta para reais\n",
    "residuos = y_val - previsto_val\n",
    "\n",
    "fig, ax = plt.subplots(1, 2, figsize=(13, 5))\n",
    "ax[0].scatter(y_val / 1e6, previsto_val / 1e6, s=8, alpha=0.5)\n",
    "ax[0].plot([0.04, 10], [0.04, 10], \"--\", color=\"gray\")\n",
    "ax[0].set_xscale(\"log\")\n",
    "ax[0].set_yscale(\"log\")\n",
    "ax[0].set_title(\"Preço observado x previsto\")\n",
    "ax[0].set_xlabel(\"Observado (milhões de R$)\")\n",
    "ax[0].set_ylabel(\"Previsto (milhões de R$)\")\n",
    "ax[1].scatter(previsto_val / 1e6, residuos / 1e6, s=8, alpha=0.5)\n",
    "ax[1].axhline(0, ls=\"--\", color=\"gray\")\n",
    "ax[1].set_title(\"Resíduos\")\n",
    "ax[1].set_xlabel(\"Previsto (milhões de R$)\")\n",
    "ax[1].set_ylabel(\"Real - previsto (milhões de R$)\")\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "erro_pct = 100 * (residuos.abs() / y_val)\n",
    "print(\"RMSLE nessa validação:\", round(root_mean_squared_error(np.log1p(y_val), np.log1p(previsto_val)), 4))\n",
    "print(\"RMSE nessa validação:\", round(root_mean_squared_error(y_val, previsto_val)))\n",
    "print(\"Erro percentual médio:\", round(erro_pct.mean(), 1), \"%\")\n",
    "print(\"Metade dos anúncios tem erro abaixo de:\", round(erro_pct.median(), 1), \"%\")"
   ]
  },
