    "base_rf = {\"n_estimators\": 200, \"max_features\": 0.6, \"min_samples_leaf\": 2,\n",
    "           \"random_state\": SEED, \"n_jobs\": -1}\n",
    "base_xgb = {\"n_estimators\": 500, \"learning_rate\": 0.05, \"max_depth\": 5, \"subsample\": 0.85,\n",
    "            \"colsample_bytree\": 0.85, \"random_state\": SEED, \"n_jobs\": -1}\n",
    "base_lgbm = {\"n_estimators\": 500, \"learning_rate\": 0.05, \"num_leaves\": 31, \"min_child_samples\": 20,\n",
    "             \"subsample\": 0.85, \"subsample_freq\": 1, \"colsample_bytree\": 0.85,\n",
    "             \"random_state\": SEED, \"n_jobs\": -1, \"verbosity\": -1}\n",
    "\n",
    "bases = {\"Random Forest\": base_rf, \"XGBoost\": base_xgb, \"LightGBM\": base_lgbm}\n",
    "nomes_modelos = [\"Random Forest\", \"XGBoost\", \"LightGBM\"]\n",
    "\n",
    "# guarda os pipelines de cada configuração para a comparação final\n",
    "configuracoes = {}\n",
    "linhas = []\n",
    "for nome in nomes_modelos:\n",
    "    pipe = montar_pipeline(criar_modelo(nome, bases[nome]))\n",
    "    configuracoes[nome + \" - Baseline\"] = pipe\n",
    "    linhas.append(avaliar(nome, pipe, X_treino, y_log_treino))\n",
    "\n",
    "baselines = pd.DataFrame(linhas)\n",
    "baselines.round(4)"
   ]
