    "final = pd.concat([baselines, resultado_grid, resultado_optuna], ignore_index=True)\n",
    "final[\"Gap\"] = final[\"RMSLE_CV\"] - final[\"RMSLE_treino\"]\n",
    "final[\"Gap_%\"] = 100 * final[\"Gap\"] / final[\"RMSLE_treino\"]\n",
    "final = final[[\"Modelo\", \"Configuração\", \"RMSLE_treino\", \"RMSLE_CV\", \"RMSLE_CV_dp\",\n",
    "               \"Gap\", \"Gap_%\", \"Tempo_treino_s\"]]\n",
    "final = final.sort_values(\"RMSLE_CV\").reset_index(drop=True)\n",
    "final.round(4)"
