   "source": [
    "def rmsle_cv(nome, parametros):\n",
    "    pipe = montar_pipeline(criar_modelo(nome, parametros))\n",
    "    notas = cross_val_score(pipe, X_treino, y_log_treino, cv=cv, scoring=\"neg_root_mean_squared_error\")\n",
    "    return -notas.mean()\n",
    "\n",
    "\n",
    "def objetivo_rf(trial):\n",
    "    sugeridos = {\n",
    "        \"n_estimators\": trial.suggest_int(\"n_estimators\", 100, 250, step=50),\n",
    "        \"max_depth\": trial.suggest_categorical(\"max_depth\", [None, 10, 16, 24]),\n",
    "        \"min_samples_leaf\": trial.suggest_int(\"min_samples_leaf\", 1, 8),\n",
    "        \"max_features\": trial.suggest_float(\"max_features\", 0.3, 1.0),\n",
    "    }\n",
    "    return rmsle_cv(\"Random Forest\", {**base_rf, **sugeridos})\n",
    "\n",
    "\n",
    "def objetivo_xgb(trial):\n",
    "    sugeridos = {\n",
    "        \"n_estimators\": trial.suggest_int(\"n_estimators\", 200, 1200, step=100),\n",
    "        \"learning_rate\": trial.suggest_float(\"learning_rate\", 0.01, 0.15, log=True),\n",
    "        \"max_depth\": trial.suggest_int(\"max_depth\", 3, 9),\n",
    "        \"min_child_weight\": trial.suggest_float(\"min_child_weight\", 1, 15),\n",
    "        \"subsample\": trial.suggest_float(\"subsample\", 0.6, 1.0),\n",
    "    }\n",
    "    return rmsle_cv(\"XGBoost\", {**base_xgb, **sugeridos})\n",
    "\n",
    "\n",
    "def objetivo_lgbm(trial):\n",
    "    sugeridos = {\n",
    "        \"n_estimators\": trial.suggest_int(\"n_estimators\", 200, 1200, step=100),\n",
    "        \"learning_rate\": trial.suggest_float(\"learning_rate\", 0.01, 0.15, log=True),\n",
    "        \"num_leaves\": trial.suggest_int(\"num_leaves\", 8, 96),\n",
    "        \"min_child_samples\": trial.suggest_int(\"min_child_samples\", 5, 60),\n",
    "        \"subsample\": trial.suggest_float(\"subsample\", 0.6, 1.0),\n",
    "    }\n",
    "    return rmsle_cv(\"LightGBM\", {**base_lgbm, **sugeridos})\n",
    "\n",
    "\n",
    "objetivos = {\"Random Forest\": objetivo_rf, \"XGBoost\": objetivo_xgb, \"LightGBM\": objetivo_lgbm}\n",
    "estudos = {}\n",
    "linhas = []\n",
    "for nome in nomes_modelos:\n",
    "    estudo = optuna.create_study(direction=\"minimize\", sampler=TPESampler(seed=SEED))\n",
    "    inicio = perf_counter()\n",
    "    estudo.optimize(objetivos[nome], n_trials=20)\n",
    "    tempo_busca = perf_counter() - inicio\n",
    "    estudos[nome] = estudo\n",
    "\n",
    "    print(nome, \"- melhores parâmetros:\", estudo.best_params)\n",
    "    pipe = montar_pipeline(criar_modelo(nome, {**bases[nome], **estudo.best_params}))\n",
    "    configuracoes[nome + \" - Optuna\"] = pipe\n",
    "\n",
    "    linha = avaliar(nome, pipe, X_treino, y_log_treino)\n",
    "    linha[\"Trials\"] = 20\n",
    "    linha[\"Trial_do_melhor\"] = estudo.best_trial.number + 1\n",
    "    linha[\"Tempo_busca_s\"] = tempo_busca\n",
    "    linhas.append(linha)\n",
    "\n",
    "resultado_optuna = pd.DataFrame(linhas)\n",
    "resultado_optuna[[\"Modelo\", \"Trials\", \"Trial_do_melhor\", \"RMSLE_CV\", \"RMSLE_CV_dp\", \"Tempo_busca_s\"]].round(4)"
   ]
