    "ax[1].set_title(\"Tempo de treinamento\")\n",
    "ax[1].set_ylabel(\"Segundos\")\n",
    "ax[1].set_xlabel(\"\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
